# Copy to .env.local (or .env) and set ONE provider. Both files are gitignored.

# --- Cloudinary (runs the image audit) ---
# Console -> Settings -> API Keys. The cloud name is the one shown at the top of
# the console, NOT a name you choose; a mismatch fails with "Invalid cloud_name".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or, instead of the three above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Optional AI add-ons (Console -> Add-ons). Echo uses them when enabled and
# reports which are missing when not; everything else works without them.
#   Cloudinary AI Content Analysis  -> captions usable as alt text
#   Google Auto Tagging, or Amazon Rekognition Auto Tagging -> content tags

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Models ---
#
# Free-tier Gemini allows about 5 requests per minute PER MODEL. Echo spreads
# its three roles across three different models so each gets its own budget
# rather than competing for one.
#
#   analyst  3 calls    profile, write queries, diagnose
#   probe   ~12 calls   simulate a buyer asking a question
#   reader   2 calls    read a batch of answers at once
#
# Defaults (used if unset):
#   GEMINI_MODEL=gemini-pro-latest
#   GEMINI_PROBE_MODEL=gemini-flash-latest
#   GEMINI_READER_MODEL=gemini-flash-lite-latest
#
# On a free-tier key, Pro quota is very small. Point the analyst at a flash
# model that is NOT the probe model, so they do not share a bucket:
GEMINI_MODEL=gemini-3.5-flash

# Requests per minute per model. Raise this if your key is on a paid tier.
# GEMINI_RPM=5

# Run `npm run check` — it calls each distinct model and reports per role.

# --- Alternatives, if you ever have these instead ---

# First-party Claude API
# ANTHROPIC_API_KEY=

# Claude on Amazon Bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Force a provider when more than one is configured: gemini | anthropic | bedrock
# ECHO_PROVIDER=gemini
